{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestrationStateSchema",
  "type": "object",
  "properties": {
    "project_name": { "type": "string" },
    "session_id": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "current_phase": { "type": "string" },
    "current_micro_step": { "type": "integer" },
    "active_agent": { "type": "string" },
    "completed_micro_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": { "type": "string" },
          "phase_name": { "type": "string" },
          "agent_role": { "type": "string" },
          "timestamp": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["phase_id", "phase_name", "agent_role", "timestamp", "status"]
      }
    },
    "agent_outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "last_updated": { "type": "string" },
          "raw_output": { "type": "string" },
          "parsed_data": { "type": "object" },
          "verification_passed": { "type": "boolean" }
        },
        "required": ["last_updated", "verification_passed"]
      }
    },
    "user_feedback_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "target_agent": { "type": "string" },
          "feedback_text": { "type": "string" },
          "applied_to_phase": { "type": "string" }
        },
        "required": ["timestamp", "feedback_text"]
      }
    },
    "dynamic_prompts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "audit_status": {
      "type": "object",
      "properties": {
        "audited_by_qa": { "type": "boolean" },
        "memory_leak_check_passed": { "type": "boolean" },
        "hardware_compatibility_passed": { "type": "boolean" },
        "pep8_compliance_passed": { "type": "boolean" },
        "auditing_report_path": { "type": "string" },
        "final_approval_granted": { "type": "boolean" }
      },
      "required": ["audited_by_qa", "final_approval_granted"]
    },
    "system_health": {
      "type": "object",
      "properties": {
        "token_usage_estimate": { "type": "integer" },
        "last_crash_recovery_timestamp": { "type": ["string", "null"] },
        "status": { "type": "string" }
      },
      "required": ["status"]
    }
  },
  "required": [
    "project_name",
    "session_id",
    "current_phase",
    "active_agent",
    "completed_micro_phases",
    "agent_outputs",
    "user_feedback_history",
    "audit_status",
    "system_health"
  ]
}
